+// Reuse Colada's transport serializer so special values keep their type tags.
+export function formatRawData(data, serialize) {
+  return JSON.stringify(
+    serialize(data),
+    (_key, value) => value === undefined ? "[undefined]" : value,
+    2,
+  );
+}
+
+export function withRawData(TreeViewer, { defineComponent, h, ref, computed, nextTick, watch, serialize }) {
+  return defineComponent({
+    name: "JsonViewerWithRawData",
+    props: TreeViewer.props,
+    emits: TreeViewer.emits,
+    setup(props, { emit }) {
+      const showRaw = ref(false);
+      const textarea = ref(null);
+      const status = ref("");
+      const output = computed(() => {
+        try {
+          return { text: formatRawData(props.data, serialize), error: false };
+        } catch (error) {
+          return { text: `Could not serialize data: ${String(error)}`, error: true };
+        }
+      });
+      watch(() => props.data, () => { status.value = ""; });
+
+      async function copy() {
+        const { text, error } = output.value;
+        if (error) {
+          showRaw.value = true;
+          return;
+        }
+        try {
+          await navigator.clipboard.writeText(text);
+          status.value = "Copied";
+          return;
+        } catch {
+          // Embedded panels may not have Clipboard API permission.
+        }
+        showRaw.value = true;
+        await nextTick();
+        textarea.value?.focus();
+        textarea.value?.select();
+        try {
+          if (document.execCommand("copy")) {
+            status.value = "Copied";
+            return;
+          }
+        } catch {
+          // Leave the text selected for the browser's normal copy command.
+        }
+        status.value = "Press Cmd+C or Ctrl+C to copy the selected text";
+      }
+
+      return () => h("div", {}, [
+        h("div", { style: { display: "flex", gap: "0.5rem", alignItems: "center", padding: "0.25rem" } }, [
+          h("button", {
+            type: "button",
+            class: "rounded border p-1 text-sm",
+            "aria-pressed": showRaw.value,
+            onClick: () => { showRaw.value = !showRaw.value; },
+          }, showRaw.value ? "Show tree" : "Show raw"),
+          h("button", { type: "button", class: "rounded border p-1 text-sm", onClick: copy }, "Copy JSON"),
+          h("span", { role: "status", class: "text-sm" }, status.value),
+        ]),
+        showRaw.value
+          ? h("textarea", {
+              ref: textarea,
+              readonly: true,
+              spellcheck: false,
+              "aria-label": "Raw data",
+              value: output.value.text,
+              style: {
+                display: "block", width: "100%", minHeight: "16rem", maxHeight: "50vh",
+                resize: "vertical", padding: "0.5rem", fontFamily: "monospace", fontSize: "0.75rem",
+                background: "transparent", color: "inherit", whiteSpace: "pre", overflow: "auto",
+              },
+            })
+          : h(TreeViewer, { ...props, "onUpdate:value": (...args) => emit("update:value", ...args) }),
+      ]);
+    },
+  });
+}

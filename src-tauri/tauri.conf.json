{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Öpfelmusig",
  "version": "0.1.0",
  "identifier": "dev.waradu.opfelmusig",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun generate"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Öpfelmusig",
        "dragDropEnabled": false,
        "visible": false,
        "decorations": false,
        "width": 1000,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#18181b",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
